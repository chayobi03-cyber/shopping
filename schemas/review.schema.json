{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chayobi03-cyber/shopping/schemas/review.schema.json",
  "title": "Independent Review Record",
  "type": "object",
  "required": ["review_id", "subject_run_id", "reviewer_run_id", "reviewed_at", "outcome", "checks", "findings"],
  "properties": {
    "review_id": {"type": "string"},
    "subject_run_id": {"type": "string"},
    "reviewer_run_id": {"type": "string"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL", "NOT_REVIEWED"]},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "status", "evidence_refs"],
        "properties": {
          "check_id": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "PASS"}}},
            "then": {"properties": {"evidence_refs": {"minItems": 1}}}
          }
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "description"],
        "properties": {
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "resolution": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
