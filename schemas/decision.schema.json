{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chayobi03-cyber/shopping/schemas/decision.schema.json",
  "title": "Shopping Decision Snapshot",
  "type": "object",
  "required": ["decision_id", "product_variant_id", "as_of", "hard_gates", "decision", "evidence_refs", "review_status"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "product_variant_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "hard_gates": {"type": "object", "additionalProperties": {"enum": ["PASS", "FAIL", "UNKNOWN", "STALE"]}},
    "decision": {"enum": ["BUY", "WATCH", "REJECT", "DATA_NOT_READY", "BLOCKED"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "review_status": {"enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL", "NOT_REVIEWED"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
