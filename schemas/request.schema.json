{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chayobi03-cyber/shopping/schemas/request.schema.json",
  "title": "Shopping Research Request",
  "type": "object",
  "required": ["request_id", "category", "gender", "condition", "currency", "max_total_price", "required_options", "created_at"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "category": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "gender": {"enum": ["men", "women", "unisex"]},
    "condition": {"const": "NEW"},
    "currency": {"const": "KRW"},
    "max_total_price": {"type": "integer", "minimum": 0},
    "required_options": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "preferred_brands": {"type": "array", "items": {"type": "string"}},
    "preferences": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
